# BTC Backtest PoC - 環境変数テンプレート
# .env にコピーして各自の値を設定してください
# （.env は .gitignore に登録済みで、リポジトリに保存されません）

# 価格データ取得ソース
# 選択肢: binance, ccxt, local
DATA_SOURCE=binance

# Binance API（読み取り専用、取引APIキーは使用しない）
# 注意: 実売買キーを設定しないでください。公開エンドポイントのみ使用
BINANCE_API_KEY=your_read_only_api_key_here
BINANCE_API_SECRET=your_read_only_api_secret_here

# MiroFish設定（将来のフェーズ）
# MIROFISH_API_URL=http://localhost:5001
# MIROFISH_CLI_PATH=/path/to/mirofish

# ローカルデータベース
# 選択肢: sqlite, duckdb
DB_TYPE=sqlite
DB_PATH=./data/backtest.db

# ログレベル
# 選択肢: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=./logs/backtest.log

# バックテスト設定
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_FEE_RATE=0.001
BACKTEST_SLIPPAGE_RATE=0.0005

# 出力ディレクトリ
OUTPUT_DIR=./outputs